# ============================================================
# IoT Crop Yield Prediction - Environment Configuration
# Copy this file to .env and fill in your values
# ============================================================

# --- Application ---
APP_ENV=development
SECRET_KEY=change-this-to-a-random-secret-key
LOG_LEVEL=INFO

# --- Flask Backend ---
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=true

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_SENSOR=sensor-readings
KAFKA_CONSUMER_GROUP=crop-yield-consumer-group
KAFKA_AUTO_OFFSET_RESET=earliest
KAFKA_MAX_POLL_RECORDS=100

# --- Hadoop HDFS ---
HDFS_HOST=localhost
HDFS_PORT=9870
HDFS_NAMENODE_URL=http://localhost:9870
HDFS_BASE_PATH=/crop-yield
HDFS_USER=hadoop
HDFS_BATCH_SIZE=50
HDFS_FLUSH_INTERVAL=30

# --- Local Fallback Storage ---
LOCAL_STORAGE_PATH=./data/local_fallback
USE_HDFS=true

# --- SQLite Database ---
DATABASE_PATH=./data/crop_yield.db

# --- Machine Learning ---
MODEL_PATH=./ml/saved_models/crop_yield_model.joblib
MODEL_VERSION=1.0.0
PREDICTION_HORIZON_DAYS=30

# --- IoT Simulator ---
SIMULATOR_INTERVAL=5
SIMULATOR_FIELDS=5
SIMULATOR_SEED=42
SIMULATOR_MODE=continuous

# --- Frontend ---
REACT_APP_API_URL=http://localhost:5000
